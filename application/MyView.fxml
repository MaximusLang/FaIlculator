<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>

<StackPane fx:id="BasePane" fx:controller="application.MyController" prefWidth="720" prefHeight="900" alignment="TOP_CENTER"
      xmlns="http://javafx.com/javafx/23.0.1" 
      xmlns:fx="http://javafx.com/fxml/1">
      <Pane fx:id="TilesPane" prefWidth="720" prefHeight="900"></Pane>
      <HBox fx:id="ControlPane" alignment="TOP_CENTER" spacing="10">
          <Label fx:id="calcDisplay"/>
          <Button fx:id="Decimal" text="." onAction="#addDecimal"/>
          <Button fx:id="Enter" text="Enter" onAction="#enter"/>
          <Button fx:id="Backspace" text="Backspace" onAction="#backspace"/>
     <!--<Button fx:id="Clear" text="Clear" onAction="#clear"/> -->
      </HBox>
</StackPane>
 

